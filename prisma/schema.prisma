datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             Int          @id @default(autoincrement())
  telegramId     String       @unique
  role           String
  name           String?
  teacherId      Int?
  teacher        User?        @relation("TeacherStudents", fields: [teacherId], references: [id])
  students       User[]       @relation("TeacherStudents")
  assignments    Assignment[] @relation("StudentAssignments")
  givenTasks     Assignment[] @relation("TeacherAssignments")
}

model Assignment {
  id          Int      @id @default(autoincrement())
  description String
  deadline    DateTime
  status      String   @default("PENDING")
  submission  String?
  feedback    String?
  studentId   Int
  teacherId   Int
  student     User     @relation("StudentAssignments", fields: [studentId], references: [id])
  teacher     User     @relation("TeacherAssignments", fields: [teacherId], references: [id])
}